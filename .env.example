# NECA Employers' Excellence Awards Platform — environment variables
#
# Copy this file to `.env.local` for local development. In production
# (cPanel "Setup Node.js App"), set these in the app's environment
# variables UI rather than committing a real .env file.
#
# Nothing in this file is populated yet — see comments below for who is
# responsible for producing each value.

# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Provided by: Tosin/Aeros, once the Supabase project and schema exist.
# Found in: Supabase project settings -> API.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-side only (Route Handlers/Server Actions). Bypasses Row
# Level Security. Never prefix this with NEXT_PUBLIC_ or ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Anthropic API (AI features — e.g. application-quality assistance, jury
# scoring support, TBD once features are scoped)
# Provided by: NECA.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Transactional email (application confirmations, jury invitations,
# notifications). Provider TBD — placeholder name below.
# Provided by: NECA.
# ---------------------------------------------------------------------------

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Full public URL of this app once deployed, e.g. https://apply.necaexcellenceawards.com
NEXT_PUBLIC_SITE_URL=
