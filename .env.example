# NECA Employers' Excellence Awards Platform — environment variables
#
# Copy this file to `.env.local` for local development. In production
# (cPanel "Setup Node.js App"), set these in the app's environment
# variables UI rather than committing a real .env file.
#
# Nothing in this file is populated yet — see comments below for who is
# responsible for producing each value.

# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Real project as of the Section 14 integration — 22 tables, RLS on every
# one. Found in: Supabase project settings -> API.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (it ends up in the client bundle
# regardless). "Publishable key" is Supabase's current name for what used
# to be called the anon key. Real values live in .env.local (gitignored),
# not committed here even though this key itself isn't sensitive — same
# blank-template convention as every other var in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret — server-side only. Bypasses RLS entirely — every call site using
# it (lib/supabase/admin.ts) must do its own authorization check, since RLS
# isn't doing it anymore. Used for admin-provisioning secretariat/jury
# accounts (invite-only, never self-signup) and, eventually, audit_log
# writes (no insert policy exists for authenticated users on that table, by
# design). Real value lives in .env.local (gitignored) only. Never prefix
# this with NEXT_PUBLIC_ or ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Used by backup.sh (pg_dump), NOT by the Next.js app itself. Direct
# (non-pooled) Postgres connection string — Supabase project settings ->
# Database -> Connection string -> URI, port 5432, not the pgbouncer/
# transaction-pooler string on port 6543 (pg_dump needs session-level
# access). On the server this lives in a separate .env.local next to
# backup.sh, since cPanel Cron Jobs don't inherit the Node app's own env
# vars — see the README's "Scheduled job: database backups" section and
# RESTORE.md.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Anthropic API (AI features — e.g. application-quality assistance, jury
# scoring support, TBD once features are scoped)
# Provided by: NECA.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Transactional email (application confirmations, jury invitations,
# notifications). Provider TBD — placeholder name below.
# Provided by: NECA.
# ---------------------------------------------------------------------------

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Cron / scheduled jobs
# Shared secret that authorizes calls to app/api/cron/interview-reminders
# (checked against an `x-cron-secret` header or `?secret=` query param —
# the route returns 500 if this is unset and 401 if the value doesn't
# match). Generate any long random string. See README for how this route
# is meant to be triggered on cPanel.
# ---------------------------------------------------------------------------

CRON_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Full public URL of this app once deployed, e.g. https://apply.necaexcellenceawards.com
NEXT_PUBLIC_SITE_URL=
