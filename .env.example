# NECA Employers' Excellence Awards Platform — environment variables
#
# Copy this file to `.env.local` for local development.
#
# In production, secret (non-NEXT_PUBLIC_) vars can go in cPanel's
# "Setup Node.js App" environment variables UI — that's read live at
# request time by the running app process, so it's fine. NEXT_PUBLIC_
# vars are different: Next.js inlines them into the compiled app at
# `next build` time, and that build runs over SSH (deploy.sh), a shell
# cPanel's env var UI never reaches. If they're missing from a real
# .env.local/.env.production file on disk *when the build runs*, every
# bundle that references them compiles with `undefined` baked in
# permanently — setting them in cPanel afterward and restarting the app
# does not fix an already-built bundle. See README's "Deployment"
# section — a real .env.local belongs at the app root on the server,
# once, outside git.
#
# Nothing in this file is populated yet — see comments below for who is
# responsible for producing each value.

# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# Real project as of the Section 14 integration — 22 tables, RLS on every
# one. Found in: Supabase project settings -> API.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (it ends up in the client bundle
# regardless). "Publishable key" is Supabase's current name for what used
# to be called the anon key. Real values live in .env.local (gitignored),
# not committed here even though this key itself isn't sensitive — same
# blank-template convention as every other var in this file.
#
# MUST be present in a real .env.local/.env.production file on the server
# at build time (not just cPanel's env var UI) — see the note at the top
# of this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret — server-side only. Bypasses RLS entirely — every call site using
# it (lib/supabase/admin.ts) must do its own authorization check, since RLS
# isn't doing it anymore. Used for admin-provisioning secretariat/jury
# accounts (invite-only, never self-signup) and, eventually, audit_log
# writes (no insert policy exists for authenticated users on that table, by
# design). Real value lives in .env.local (gitignored) only. Never prefix
# this with NEXT_PUBLIC_ or ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Used by backup.sh (pg_dump), NOT by the Next.js app itself. Direct
# (non-pooled) Postgres connection string — Supabase project settings ->
# Database -> Connection string -> URI, port 5432, not the pgbouncer/
# transaction-pooler string on port 6543 (pg_dump needs session-level
# access). On the server this lives in a separate .env.local next to
# backup.sh, since cPanel Cron Jobs don't inherit the Node app's own env
# vars — see the README's "Scheduled job: database backups" section and
# RESTORE.md.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Anthropic API (AI features — e.g. application-quality assistance, jury
# scoring support, TBD once features are scoped)
# Provided by: NECA.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Transactional email — Resend (https://resend.com). Used by
# lib/email/send.ts for the emails this app sends directly: interview
# invite + booking/attendance reminders (lib/actions/interviews.ts).
# Without RESEND_API_KEY set, sendEmail() just logs what it would have
# sent (console) instead of failing — safe to leave unset in dev.
#
# NOT used for jury/secretariat invite emails — those go through
# supabase.auth.admin.inviteUserByEmail() (lib/actions/users.ts), which
# sends via whatever SMTP is configured in the Supabase project itself
# (Project Settings -> Auth -> SMTP Settings), a separate mechanism from
# this file. To get invite emails onto Resend too, add Resend's SMTP
# credentials there instead of (or in addition to) setting these vars —
# no code/deploy needed for that part.
#
# Provided by: NECA (Resend account + API key).
# ---------------------------------------------------------------------------

# Resend dashboard -> API Keys.
RESEND_API_KEY=
# Must be a verified sender on the Resend account — either an address at
# a domain you've verified there, or Resend's own onboarding@resend.dev
# for testing. e.g. "NECA Awards <noreply@necaexcellenceawards.com>"
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Cron / scheduled jobs
# Shared secret that authorizes calls to app/api/cron/interview-reminders
# (checked against an `x-cron-secret` header or `?secret=` query param —
# the route returns 500 if this is unset and 401 if the value doesn't
# match). Generate any long random string. See README for how this route
# is meant to be triggered on cPanel.
# ---------------------------------------------------------------------------

CRON_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Full public URL of this app once deployed, e.g. https://apply.necaexcellenceawards.com
NEXT_PUBLIC_SITE_URL=
