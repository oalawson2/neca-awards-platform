# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SSH deploy keypair — never commit private keys. See deploy/ssh/README.md.
deploy/ssh/*
!deploy/ssh/README.md

# Maintenance-mode flag file and deploy backups — server-side toggles/state,
# never meant to be committed. See deploy/htaccess/maintenance-block.conf
# and README's Deployment section.
/MAINTENANCE_MODE
/.next/standalone.bak
